{
  "name": "chessu",
  "private": true,
  "author": {
    "name": "Nathaniel John Tampus",
    "email": "nat@nize.ph",
    "url": "https://nize.ph"
  },
  "license": "MIT",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "dev:web": "turbo run dev --filter=@chessu/web",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "check-types": "turbo run check-types",
    "check": "bun run format && turbo run lint && turbo run check-types",
    "prepare": "husky",
    "deps": "bun update -ir",
    "deps:force": "bun update -irf",
    "taze": "bun x taze@latest -Ilw",
    "taze:major": "bun x taze@latest major -Ilw",
    "db": "bun --filter=@chessu/db run db",
    "ui": "bun --filter=@chessu/ui run ui",
    "ui:web": "bun --filter=@chessu/web run ui",
    "auth:secret": "bun x @better-auth/cli@latest secret",
    "auth:generate": "bun x @better-auth/cli@latest generate --config ./packages/auth/src/auth.ts --y --output ./packages/db/src/schema/auth.schema.ts && prettier --write ./packages/db/src/schema/auth.schema.ts"
  },
  "lint-staged": {
    "*": "prettier --ignore-unknown --write"
  },
  "devDependencies": {
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-organize-imports": "catalog:",
    "prettier-plugin-tailwindcss": "catalog:",
    "turbo": "catalog:"
  },
  "packageManager": "bun@1.3.5",
  "engines": {
    "bun": "^1.3.5"
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "tooling/*"
    ],
    "catalog": {
      "@base-ui/react": "^1.0.0",
      "@eslint-react/eslint-plugin": "^2.4.0",
      "@eslint/js": "^9.39.2",
      "@tailwindcss/vite": "^4.1.18",
      "@tanstack/devtools-vite": "^0.4.0",
      "@tanstack/eslint-plugin-query": "^5.91.2",
      "@tanstack/eslint-plugin-router": "^1.141.0",
      "@tanstack/react-devtools": "^0.9.0",
      "@tanstack/react-form-devtools": "^0.2.9",
      "@tanstack/react-form-start": "^1.27.6",
      "@tanstack/react-query": "^5.90.12",
      "@tanstack/react-query-devtools": "^5.91.1",
      "@tanstack/react-router": "^1.144.0",
      "@tanstack/react-router-devtools": "^1.144.0",
      "@tanstack/react-router-ssr-query": "^1.144.0",
      "@tanstack/react-start": "^1.144.0",
      "@types/node": "^24.10.4",
      "@types/react": "^19.2.7",
      "@types/react-dom": "^19.2.3",
      "@vitejs/plugin-react": "^5.1.2",
      "babel-plugin-react-compiler": "^1.0.0",
      "better-auth": "^1.4.9",
      "class-variance-authority": "^0.7.1",
      "clsx": "^2.1.1",
      "date-fns": "^4.1.0",
      "drizzle-kit": "^0.31.8",
      "drizzle-orm": "^0.45.1",
      "eslint": "^9.39.2",
      "eslint-config-prettier": "^10.1.8",
      "eslint-plugin-only-warn": "^1.1.0",
      "eslint-plugin-react-hooks": "^7.0.1",
      "eslint-plugin-turbo": "^2.7.2",
      "husky": "^9.1.7",
      "lint-staged": "^16.2.7",
      "lucide-react": "^0.562.0",
      "nitro": "npm:nitro-nightly@latest",
      "postgres": "^3.4.7",
      "prettier": "^3.7.4",
      "prettier-plugin-organize-imports": "^4.3.0",
      "prettier-plugin-tailwindcss": "^0.7.2",
      "react": "^19.2.3",
      "react-dom": "^19.2.3",
      "shadcn": "^3.6.2",
      "sonner": "^2.0.7",
      "tailwind-merge": "^3.4.0",
      "tailwindcss": "^4.1.18",
      "turbo": "^2.7.2",
      "tw-animate-css": "^1.4.0",
      "typescript": "^5.9.3",
      "typescript-eslint": "^8.50.1",
      "vite": "^8.0.0-beta.5",
      "zod": "^4.2.1"
    }
  },
  "overrides": {
    "vite": "^8.0.0-beta.5"
  }
}
